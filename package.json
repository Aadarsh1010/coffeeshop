{
  "name": "brew-and-soul",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Brew & Soul — Premium Artisan Coffee Shop Website",
  "homepage": "https://brewandsoul.com",
  "scripts": {
    "dev":          "npx vite",
    "build":        "npx vite build",
    "preview":      "npx vite preview",
    "build:report": "npx vite build && du -sh dist && find dist -name '*.js' -o -name '*.css' | xargs ls -lh",
    "clean":        "rm -rf dist node_modules/.vite",
    "lint":         "echo 'Add ESLint when ready: npm i -D eslint @eslint/js eslint-plugin-react'",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir=dist",
    "deploy:vercel":  "npm run build && npx vercel --prod",
    "postinstall":  "chmod +x node_modules/.bin/vite 2>/dev/null || true"
  },
  "dependencies": {
    "framer-motion": "^11.0.8",
    "lucide-react":  "^0.344.0",
    "react":         "^18.2.0",
    "react-dom":     "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react":         "^18.2.66",
    "@types/react-dom":     "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer":         "^10.4.18",
    "postcss":              "^8.4.35",
    "tailwindcss":          "^3.4.1",
    "vite":                 "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm":  ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
