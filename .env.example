# =====================================================
#  Brew & Soul — Environment Variables
# =====================================================
# Copy this file to `.env` (or `.env.local`) and fill in
# real values. NEVER commit `.env` files to git.
#
# All variables MUST be prefixed with VITE_ to be exposed
# to the browser bundle.
# =====================================================

# ─────────────────────────────────────────────────────
#  Site
# ─────────────────────────────────────────────────────
VITE_SITE_URL="https://brewandsoul.com"
VITE_SITE_NAME="Brew & Soul"

# ─────────────────────────────────────────────────────
#  Contact form
#  Pick ONE of the providers below. If none are set,
#  the form falls back to a simulated send (good for dev).
# ─────────────────────────────────────────────────────

# Option A — Formspree   (https://formspree.io)
# Get your form ID from your Formspree dashboard.
VITE_FORMSPREE_ID=""

# Option B — Custom API endpoint
# Your own backend that accepts a POST with the form JSON.
VITE_CONTACT_API_URL=""

# Option C — Web3Forms   (https://web3forms.com)  — no signup
VITE_WEB3FORMS_KEY=""

# ─────────────────────────────────────────────────────
#  Newsletter (footer signup)
# ─────────────────────────────────────────────────────
# Mailchimp embedded form action URL, ConvertKit, Buttondown, etc.
VITE_NEWSLETTER_API_URL=""

# ─────────────────────────────────────────────────────
#  Reservations
#  Optional webhook to receive booking submissions.
# ─────────────────────────────────────────────────────
VITE_RESERVATIONS_API_URL=""

# ─────────────────────────────────────────────────────
#  Analytics (optional)
# ─────────────────────────────────────────────────────
# Plausible
VITE_PLAUSIBLE_DOMAIN=""

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_ID=""

# ─────────────────────────────────────────────────────
#  Business info (overrides defaults if set)
# ─────────────────────────────────────────────────────
VITE_BUSINESS_PHONE="+1 (555) 234-7891"
VITE_BUSINESS_EMAIL="hello@brewandsoul.com"
VITE_WHATSAPP_NUMBER="15552347891"
